{
  "name": "fresh-playground",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @playground/web",
    "build": "npm run build -w @playground/web",
    "start": "npm run start -w @playground/web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "biome check . && npm run check --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
