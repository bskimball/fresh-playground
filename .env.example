# Optional: copy to .env at the workspace root. Shell variables take precedence.
NODE_ENV=development
HOST=127.0.0.1
PORT=4321
# Trace, Debug, Info, Warn, Error, Fatal, or None
LOG_LEVEL=Info
# Production: NODE_ENV=production enables JSON logs.
# Set HOST=0.0.0.0 only when the server should accept external connections.

# Auth. Generate a secret with: openssl rand -base64 32 (required in production)
BETTER_AUTH_SECRET=
# Public origin; OAuth redirect URIs are $BETTER_AUTH_URL/api/auth/callback/<provider>
BETTER_AUTH_URL=http://localhost:4321
# SQLite file, relative to packages/web
DATABASE_PATH=data/app.db
AUTH_PASSWORD=true
# Defaults to on outside production. Production requires SMTP and explicit true.
AUTH_MAGIC_LINK=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Defaults to log in development/test, disabled in production.
# Production: use smtp to deliver email; log is rejected in production.
MAIL_TRANSPORT=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# false + REQUIRE_TLS=true uses mandatory STARTTLS (usually port 587).
# For implicit TLS (usually port 465), set SMTP_SECURE=true.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Set both credentials, or leave both empty for an unauthenticated relay.
SMTP_USER=
SMTP_PASSWORD=

# Uploaded files: local (default) or s3 (any S3-compatible service, path-style).
STORAGE_DRIVER=local
# Relative to packages/web. Keep it on the same persistent disk as the database.
STORAGE_PATH=data/uploads
S3_BUCKET=
S3_REGION=us-east-1
# Defaults to https://s3.<region>.amazonaws.com; set it for MinIO, R2, and others.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# API and sign-in rate limits key on the client address. Behind exactly one reverse
# proxy that appends X-Forwarded-For, set true; otherwise every client shares the proxy's limit.
TRUST_PROXY=false

# OpenTelemetry: an OTLP/HTTP endpoint such as http://localhost:4318 exports traces,
# metrics, and logs from the production server (npm run start). Unset exports nothing.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated key=value pairs, e.g. for a vendor API key.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=fresh-playground
