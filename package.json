{
  "name": "fresh-playground",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp -C packages/web run dev",
    "build": "vp -C packages/web build --app",
    "start": "vp -C packages/web run start",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "vp test --run",
    "check": "vp check && vp run -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  }
}
