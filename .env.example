# Optional: copy to .env at the workspace root. Shell variables take precedence.
NODE_ENV=development
HOST=127.0.0.1
PORT=4321
# Trace, Debug, Info, Warn, Error, Fatal, or None
LOG_LEVEL=Info
# Production: NODE_ENV=production enables JSON logs.
# Set HOST=0.0.0.0 only when the server should accept external connections.

# Auth. Generate a secret with: openssl rand -base64 32 (required in production)
BETTER_AUTH_SECRET=
# Public origin; OAuth redirect URIs are $BETTER_AUTH_URL/api/auth/callback/<provider>
BETTER_AUTH_URL=http://localhost:4321
# SQLite file, relative to packages/web
DATABASE_PATH=data/app.db
AUTH_PASSWORD=true
# Defaults to on outside production. Production requires SMTP and explicit true.
AUTH_MAGIC_LINK=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Defaults to log in development/test, disabled in production.
# Production: use smtp to deliver email; log is rejected in production.
MAIL_TRANSPORT=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
# false + REQUIRE_TLS=true uses mandatory STARTTLS (usually port 587).
# For implicit TLS (usually port 465), set SMTP_SECURE=true.
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Set both credentials, or leave both empty for an unauthenticated relay.
SMTP_USER=
SMTP_PASSWORD=
